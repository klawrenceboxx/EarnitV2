<?xml version="1.0" encoding="utf-8"?>
<!-- Cloud Sync sign-in tokens must never leave the device through backup or device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="earnit_cloud_sync.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="earnit_cloud_sync.xml" />
    </device-transfer>
</data-extraction-rules>
